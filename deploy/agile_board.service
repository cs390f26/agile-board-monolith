[Unit]
Description=Agile Board Web Application
After=network.target postgresql.service

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/agile-board-monolith
Environment="PYTHONPATH=src"
EnvironmentFile=-/agile-board-monolith/.env
# Grants just the one specific Linux capability needed to bind low ports, without making the whole Gunicorn process run as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/agile-board-monolith/.venv/bin/gunicorn 'agile_board.app:create_app()' --bind 0.0.0.0:80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target